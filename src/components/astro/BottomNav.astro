---
const pathname: string = Astro.url.pathname;

interface NavItem {
  href: string;
  label: string;
  icon: string;
}

const items: NavItem[] = [
  { href: '/', label: 'Inicio', icon: '🏠' },
  { href: '/pronosticar', label: 'Pronosticar', icon: '⚽' },
  { href: '/ranking', label: 'Ranking', icon: '🏆' },
  { href: '/historial', label: 'Historial', icon: '📜' }
];
---

<nav
  class="fixed bottom-0 left-0 right-0 bg-white/90 backdrop-blur-lg border-t border-[rgba(2,48,71,0.08)] px-2 py-2 z-50"
>
  <div class="max-w-md mx-auto flex justify-around items-center">
    {
      items.map((item: NavItem) => {
        const isActive: boolean = pathname === item.href;
        return (
          <a
            href={item.href}
            class:list={[
              'flex flex-col items-center gap-1 px-3 py-2 rounded-xl transition-all duration-200 min-w-[64px]',
              isActive
                ? 'bg-gradient-to-r from-[#FFB703] to-[#FB8500] text-[#1A1A2E] shadow-md shadow-[rgba(251,133,0,0.3)]'
                : 'text-[#6B7280] hover:text-[#023047]'
            ]}
          >
            <span class="text-xl">{item.icon}</span>
            <span class="text-[10px] font-bold">{item.label}</span>
          </a>
        );
      })
    }
  </div>
</nav>
