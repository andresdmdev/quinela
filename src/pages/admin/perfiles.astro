---
import LayoutApp from '../../layouts/LayoutApp.astro';
import { AdminProfilesList } from '../../components/react/AdminProfilesList';

const user = Astro.locals.user;
const isAdmin = user?.email === 'andresdmf55@gmail.com';

if (!isAdmin) {
  return Astro.redirect('/');
}
---

<LayoutApp title="Administrar perfiles - Quiniela Mundial 2026">
  <header class="mb-6">
    <p class="text-sm font-medium text-[#FB8500] mb-1">Administración</p>
    <h1 class="text-2xl font-black text-[#1A1A2E]">Gestionar perfiles</h1>
    <p class="text-sm text-[#6B7280] mt-1">
      Habilita o deshabilita el acceso de los jugadores a la quiniela.
    </p>
  </header>

  <AdminProfilesList client:load />
</LayoutApp>
