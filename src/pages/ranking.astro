---
import LayoutApp from '../layouts/LayoutApp.astro';
import { Leaderboard } from '../components/react/Leaderboard';
---

<LayoutApp title="Ranking - Quiniela Mundial 2026">
  <header class="mb-6">
    <p class="text-sm font-medium text-[#FB8500] mb-1">Tabla de posiciones</p>
    <h1 class="text-2xl font-black text-[#1A1A2E]">Quién gana el banquete</h1>
    <p class="text-sm text-[#6B7280] mt-1">
      Top 2 en dorado ganan, el resto paga la cuenta.
    </p>
  </header>

  <Leaderboard client:load />
</LayoutApp>
