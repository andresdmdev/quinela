---
import LayoutApp from '../layouts/LayoutApp.astro';
import { CountdownTimer } from '../components/react/CountdownTimer';
import { AwardBettingPage } from '../components/react/AwardBettingPage';
---

<LayoutApp title="Premios - Quiniela Mundial 2026">
  <header class="mb-6">
    <p class="text-sm font-medium text-[#FB8500] mb-1">Apuestas especiales</p>
    <h1 class="text-2xl font-black text-[#1A1A2E]">Premios del Mundial</h1>
    <p class="text-sm text-[#6B7280] mt-1">
      Pronostica los premios y gana puntos extra.
    </p>
  </header>

  <section class="mb-6">
    <CountdownTimer className="" client:load />
  </section>

  <section class="mb-6">
    <div class="bg-gradient-to-br from-[#FFB703] to-[#FB8500] rounded-3xl p-5 text-white shadow-lg shadow-[rgba(251,133,0,0.25)]">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🎯</span>
        <div>
          <h2 class="text-lg font-bold">Cómo funciona</h2>
          <p class="text-sm text-white/80">Apuesta puntos: 2-5 por premio. Si aciertas, recuperas tu apuesta + ganas 3x. Si pierdes, solo pierdes lo apostado.</p>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-3 text-center">
        <div class="bg-white/15 rounded-xl p-3">
          <p class="text-2xl font-black">2-5</p>
          <p class="text-xs text-white/80">Pts a apostar</p>
        </div>
        <div class="bg-white/15 rounded-xl p-3">
          <p class="text-2xl font-black">3x</p>
          <p class="text-xs text-white/80">Ganado si aciertas</p>
        </div>
        <div class="bg-white/15 rounded-xl p-3">
          <p class="text-2xl font-black">3</p>
          <p class="text-xs text-white/80">Premios</p>
        </div>
      </div>
    </div>
  </section>

  <AwardBettingPage client:load />
</LayoutApp>
