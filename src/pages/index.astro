---
import LayoutApp from '../layouts/LayoutApp.astro';
import { MatchList } from '../components/react/MatchList';
import { Leaderboard } from '../components/react/Leaderboard';
import { CountdownTimer } from '../components/react/CountdownTimer';

const user = Astro.locals.user;
const displayName = user?.user_metadata?.full_name ?? user?.email ?? 'Jugador';
---

<LayoutApp title="Inicio - Quiniela Mundial 2026">
  <header class="mb-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-[#FB8500] mb-1">FIFA World Cup 2026</p>
        <h1 class="text-2xl font-black text-[#1A1A2E]">Hola, {displayName}</h1>
      </div>
      <a
        href="/perfil"
        class="w-10 h-10 rounded-full bg-gradient-to-br from-[#FFB703] to-[#FB8500] flex items-center justify-center text-white font-bold shadow-md shadow-[rgba(251,133,0,0.3)]"
      >
        {displayName.charAt(0).toUpperCase()}
      </a>
    </div>
  </header>

  <section class="mb-6">
    <CountdownTimer className="" client:load />
  </section>

  <section class="mb-6">
    <div class="bg-gradient-to-br from-[#023047] to-[#03496b] rounded-3xl p-6 text-white shadow-lg shadow-[rgba(2,48,71,0.25)]">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-3xl">🏆</span>
        <div>
          <h2 class="text-lg font-bold">Banquete Mundialista</h2>
          <p class="text-sm text-white/80">Top 2 ganan · 4 restantes pagan</p>
        </div>
      </div>
      <div class="flex gap-3">
        <div class="flex-1 bg-white/10 rounded-xl p-3 text-center backdrop-blur-sm">
          <p class="text-2xl font-black text-[#FFB703]">2</p>
          <p class="text-xs text-white/80">Ganadores</p>
        </div>
        <div class="flex-1 bg-white/10 rounded-xl p-3 text-center backdrop-blur-sm">
          <p class="text-2xl font-black text-[#EF476F]">4</p>
          <p class="text-xs text-white/80">Pagan</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-black text-[#1A1A2E]">Próximos partidos</h2>
      <a href="/pronosticar" class="text-sm font-bold text-[#FB8500] hover:text-[#FFB703] transition-colors">
        Ver todos →
      </a>
    </div>
    <MatchList filter="upcoming" limit={3} client:load />
  </section>

  <section class="mb-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-black text-[#1A1A2E]">Tabla de posiciones</h2>
      <a href="/ranking" class="text-sm font-bold text-[#FB8500] hover:text-[#FFB703] transition-colors">
        Completo →
      </a>
    </div>
    <Leaderboard client:load />
  </section>

  <section>
    <h2 class="text-lg font-black text-[#1A1A2E] mb-4">Reglas de puntuación</h2>
    <div class="bg-white rounded-3xl p-5 shadow-sm shadow-[rgba(255,183,3,0.1)] border border-[rgba(2,48,71,0.06)] space-y-6">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="text-xl">⚽</span>
          <h3 class="font-bold text-[#023047] text-base">Fase de Grupos</h3>
        </div>
        <p class="text-sm text-[#6B7280] mb-3">
          Solo se evalúa el resultado de los <strong>90 minutos</strong>.
        </p>
        <div class="flex flex-wrap gap-3 text-sm mb-4">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[rgba(6,214,160,0.12)] text-[#06A77D] rounded-lg font-semibold">
            Marcador exacto: 5 pts
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[rgba(255,183,3,0.15)] text-[#9a6b00] rounded-lg font-semibold">
            Tendencia: 2 pts
          </span>
        </div>
        <div class="overflow-x-auto -mx-5 px-5">
          <table class="w-full min-w-[400px] text-sm">
            <thead>
              <tr class="border-b border-[rgba(2,48,71,0.08)]">
                <th class="text-left py-2 font-semibold text-[#1A1A2E] whitespace-nowrap">Tu prónostico</th>
                <th class="text-left py-2 font-semibold text-[#1A1A2E] whitespace-nowrap">Resultado</th>
                <th class="text-center py-2 font-semibold text-[#1A1A2E]">Pts</th>
                <th class="text-left py-2 font-semibold text-[#1A1A2E]">Razón</th>
              </tr>
            </thead>
            <tbody class="text-[#6B7280]">
              <tr class="border-b border-[rgba(2,48,71,0.04)]">
                <td class="py-2 font-mono whitespace-nowrap">2-1</td>
                <td class="py-2 font-mono whitespace-nowrap">2-1</td>
                <td class="py-2 text-center"><span class="font-bold text-[#06A77D]">5</span></td>
                <td class="py-2">Marcador exacto</td>
              </tr>
              <tr class="border-b border-[rgba(2,48,71,0.04)]">
                <td class="py-2 font-mono whitespace-nowrap">2-1</td>
                <td class="py-2 font-mono whitespace-nowrap">1-0</td>
                <td class="py-2 text-center"><span class="font-bold text-[#9a6b00]">2</span></td>
                <td class="py-2">Acertaste Local gana</td>
              </tr>
              <tr class="border-b border-[rgba(2,48,71,0.04)]">
                <td class="py-2 font-mono whitespace-nowrap">2-1</td>
                <td class="py-2 font-mono whitespace-nowrap">2-2</td>
                <td class="py-2 text-center"><span class="font-bold text-[#9a6b00]">2</span></td>
                <td class="py-2">Acertaste empate</td>
              </tr>
              <tr>
                <td class="py-2 font-mono whitespace-nowrap">2-1</td>
                <td class="py-2 font-mono whitespace-nowrap">3-1</td>
                <td class="py-2 text-center"><span class="font-bold text-[#EF476F]">0</span></td>
                <td class="py-2">Fallaste</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="border-t border-[rgba(2,48,71,0.06)] pt-5">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-xl">🏆</span>
          <h3 class="font-bold text-[#023047] text-base">Eliminatorias</h3>
        </div>
        <p class="text-sm text-[#6B7280] mb-4">
          Se evalúa <strong>cada etapa</strong> independientemente. Solo suman las etapas que el partido alcanzó.
        </p>

        <div class="p-3 bg-[rgba(255,183,3,0.1)] rounded-xl mb-5 text-sm">
          <p class="font-bold text-[#9a6b00] mb-1">Importante:</p>
          <p class="text-[#6B7280]">
            Los marcadores de <strong>120&apos;</strong> y <strong>Penales</strong> son <strong>independientes</strong>, no acumulativos.
            Si predices 1-1 en 90&apos; y 1-0 en 120&apos;, se evalúa como 1-0 en los 120 minutos, no como 2-1 total.
          </p>
        </div>

        <div class="grid grid-cols-3 gap-3 text-sm mb-5">
          <div class="p-3 bg-[rgba(2,48,71,0.04)] rounded-xl text-center">
            <p class="text-2xl mb-1">⏱️</p>
            <p class="font-bold text-[#1A1A2E]">90 min</p>
            <p class="text-[#06A77D] font-semibold">Exacto: 5 pts</p>
            <p class="text-[#6B7280]">Tendencia: 2 pts</p>
          </div>
          <div class="p-3 bg-[rgba(2,48,71,0.04)] rounded-xl text-center">
            <p class="text-2xl mb-1">⏱️⏱️</p>
            <p class="font-bold text-[#1A1A2E]">120 min</p>
            <p class="text-[#06A77D] font-semibold">Exacto: 3 pts</p>
            <p class="text-[#6B7280]">Tendencia: 2 pts</p>
          </div>
          <div class="p-3 bg-[rgba(2,48,71,0.04)] rounded-xl text-center">
            <p class="text-2xl mb-1">🥅</p>
            <p class="font-bold text-[#1A1A2E]">Penales</p>
            <p class="text-[#06A77D] font-semibold">Exacto: 6 pts</p>
            <p class="text-[#6B7280]">Tendencia: 2 pts</p>
          </div>
        </div>

        <div class="space-y-4">
          <p class="font-bold text-[#9a6b00] text-sm">Ejemplos prácticos:</p>

          <div class="p-4 bg-[rgba(6,214,160,0.08)] rounded-xl">
            <div class="flex items-start gap-3 mb-2">
              <span class="text-lg mt-0.5">✅</span>
              <div>
                <p class="font-semibold text-[#1A1A2E]">Partido termina 1-1 en 90', 2-1 en 120'</p>
                <p class="text-sm text-[#6B7280]">Predicción: 1-1 (90') y 2-1 (120')</p>
              </div>
            </div>
            <div class="ml-8 flex items-center gap-2 text-sm">
              <span class="font-mono text-[#6B7280]">5 + 3</span>
              <span class="text-[#6B7280]">=</span>
              <span class="font-bold text-[#06A77D]">8 pts</span>
            </div>
          </div>

          <div class="p-4 bg-[rgba(6,214,160,0.08)] rounded-xl">
            <div class="flex items-start gap-3 mb-2">
              <span class="text-lg mt-0.5">🏆</span>
              <div>
                <p class="font-semibold text-[#1A1A2E]">Partido llega a penales: 1-1 (90'), 1-1 (120'), 4-2</p>
                <p class="text-sm text-[#6B7280]">Predicción: 1-1, 1-1, 4-2</p>
              </div>
            </div>
            <div class="ml-8 flex items-center gap-2 text-sm">
              <span class="font-mono text-[#6B7280]">5 + 3 + 6</span>
              <span class="text-[#6B7280]">=</span>
              <span class="font-bold text-[#06A77D]">14 pts</span>
              <span class="text-xs text-[#6B7280]">(máximo posible)</span>
            </div>
          </div>

          <div class="p-4 bg-[rgba(255,183,3,0.08)] rounded-xl">
            <div class="flex items-start gap-3 mb-2">
              <span class="text-lg mt-0.5">⚠️</span>
              <div>
                <p class="font-semibold text-[#1A1A2E]">No acertaste exacto en 120'</p>
                <p class="text-sm text-[#6B7280]">Predicción: 1-1 (90') y 1-0 (120') · Resultado: 1-1 (90'), 2-1 (120')</p>
              </div>
            </div>
            <div class="ml-8 flex items-center gap-2 text-sm">
              <span class="font-mono text-[#6B7280]">5 (90') + 2 (tendencia 120')</span>
              <span class="text-[#6B7280]">=</span>
              <span class="font-bold text-[#9a6b00]">7 pts</span>
              <span class="text-xs text-[#6B7280]">(120': acertaste ganador pero no score)</span>
            </div>
          </div>

          <div class="p-4 bg-[rgba(255,183,3,0.08)] rounded-xl">
            <div class="flex items-start gap-3 mb-2">
              <span class="text-lg mt-0.5">🟡</span>
              <div>
                <p class="font-semibold text-[#1A1A2E]">Partido termina en 90' (no llegó a 120')</p>
                <p class="text-sm text-[#6B7280]">Predicción: 2-1 (90') · Resultado: 2-1</p>
              </div>
            </div>
            <div class="ml-8 flex items-center gap-2 text-sm">
              <span class="font-mono text-[#6B7280]">5</span>
              <span class="text-[#6B7280]">=</span>
              <span class="font-bold text-[#06A77D]">5 pts</span>
              <span class="text-xs text-[#6B7280]">(120' y penales no cuentan)</span>
            </div>
          </div>

          <div class="p-4 bg-[rgba(239,71,111,0.08)] rounded-xl">
            <div class="flex items-start gap-3 mb-2">
              <span class="text-lg mt-0.5">❌</span>
              <div>
                <p class="font-semibold text-[#1A1A2E]">Fallaste penales</p>
                <p class="text-sm text-[#6B7280]">Predicción: 1-1, 1-1, 5-4 · Resultado: 1-1, 1-1, 5-3</p>
              </div>
            </div>
            <div class="ml-8 flex items-center gap-2 text-sm">
              <span class="font-mono text-[#6B7280]">5 + 3 + 0</span>
              <span class="text-[#6B7280]">=</span>
              <span class="font-bold text-[#EF476F]">8 pts</span>
              <span class="text-xs text-[#6B7280]">(90' y 120' exactos, penales fallados)</span>
            </div>
          </div>

          <div class="p-4 bg-[rgba(255,183,3,0.08)] rounded-xl">
            <div class="flex items-start gap-3 mb-2">
              <span class="text-lg mt-0.5">🔄</span>
              <div>
                <p class="font-semibold text-[#1A1A2E]">Tendencia correcta en penales</p>
                <p class="text-sm text-[#6B7280]">Predicción: 1-1, 1-1, 4-3 · Resultado: 1-1, 1-1, 5-4</p>
              </div>
            </div>
            <div class="ml-8 flex items-center gap-2 text-sm">
              <span class="font-mono text-[#6B7280]">5 + 3 + 2</span>
              <span class="text-[#6B7280]">=</span>
              <span class="font-bold text-[#9a6b00]">10 pts</span>
              <span class="text-xs text-[#6B7280]">(90' y 120' exactos, tendencia penales: acertaste Local gana)</span>
            </div>
          </div>
        </div>
      </div>

      <div class="border-t border-[rgba(2,48,71,0.06)] pt-5">
        <h4 class="font-bold text-[#023047] mb-3 text-sm">¿Qué es "Tendencia"?</h4>
        <p class="text-sm text-[#6B7280] mb-3">
          <strong>Tendencia</strong> significa acertar quién gana o si hay empate, sin importar el marcador exacto.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
          <div class="p-3 bg-[rgba(6,214,160,0.08)] rounded-lg">
            <p class="font-semibold text-[#06A77D] mb-1">Local gana</p>
            <p class="text-[#6B7280] text-xs">Predijiste Local &gt; Visitante y acertaste</p>
          </div>
          <div class="p-3 bg-[rgba(239,71,111,0.08)] rounded-lg">
            <p class="font-semibold text-[#EF476F] mb-1">Visitante gana</p>
            <p class="text-[#6B7280] text-xs">Predijiste Visitante &gt; Local y acertaste</p>
          </div>
          <div class="p-3 bg-[rgba(255,183,3,0.12)] rounded-lg">
            <p class="font-semibold text-[#9a6b00] mb-1">Empate</p>
            <p class="text-[#6B7280] text-xs">Predijiste Local = Visitante y hubo empate</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</LayoutApp>
