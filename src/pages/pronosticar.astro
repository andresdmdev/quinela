---
import LayoutApp from '../layouts/LayoutApp.astro';
import { PredictionForm } from '../components/react/PredictionForm';
---

<LayoutApp title="Pronosticar - Quiniela Mundial 2026">
  <header class="mb-6">
    <p class="text-sm font-medium text-[#FB8500] mb-1">Tus pronósticos</p>
    <h1 class="text-2xl font-black text-[#1A1A2E]">Pronostica los resultados</h1>
    <p class="text-sm text-[#6B7280] mt-1">
      Los pronósticos se bloquean 1 hora antes de cada partido.
    </p>
  </header>

  <PredictionForm client:load />
</LayoutApp>
