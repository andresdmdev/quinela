---
import LayoutApp from '../layouts/LayoutApp.astro';
import { ProfileForm } from '../components/react/ProfileForm';

const user = Astro.locals.user;
const isAdmin = user?.email === 'andresdmf55@gmail.com';
---

<LayoutApp title="Perfil - Quiniela Mundial 2026">
  <header class="mb-6">
    <p class="text-sm font-medium text-[#FB8500] mb-1">Configuración</p>
    <h1 class="text-2xl font-black text-[#1A1A2E]">Tu perfil</h1>
    <p class="text-sm text-[#6B7280] mt-1">
      Personaliza tu nombre y avatar para que todos te reconozcan.
    </p>
  </header>

  <ProfileForm client:load />

  {isAdmin && (
    <section class="mt-6">
      <div class="bg-gradient-to-br from-[#023047] to-[#03496b] rounded-3xl p-5 text-white shadow-lg shadow-[rgba(2,48,71,0.25)]">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-2xl">⚙️</span>
          <div>
            <h2 class="font-bold">Zona de administración</h2>
            <p class="text-sm text-white/80">Habilita o deshabilita el acceso de los jugadores</p>
          </div>
        </div>
        <a
          href="/admin/perfiles"
          class="block w-full text-center py-3 rounded-xl bg-white/15 font-bold hover:bg-white/25 transition-colors"
        >
          Gestionar perfiles
        </a>
      </div>
    </section>
  )}
</LayoutApp>
