---
import LayoutApp from '../layouts/LayoutApp.astro';
import { MatchList } from '../components/react/MatchList';
---

<LayoutApp title="Historial - Quiniela Mundial 2026">
  <header class="mb-6">
    <p class="text-sm font-medium text-[#FB8500] mb-1">Resultados oficiales</p>
    <h1 class="text-2xl font-black text-[#1A1A2E]">Historial de partidos</h1>
    <p class="text-sm text-[#6B7280] mt-1">
      Revisa los resultados y los pronósticos de todos.
    </p>
  </header>

  <MatchList
    filter="finished"
    showSearch={true}
    client:load
    emptyTitle="No hay partidos finalizados"
    emptyDescription="Los partidos finalizados aparecerán aquí una vez que el Mundial comience."
  />
</LayoutApp>
