---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Acceso no habilitado - Quiniela Mundial 2026">
  <main class="min-h-screen flex items-center justify-center px-4 bg-gradient-to-br from-[#FFFCF9] via-[#FFF8F0] to-[rgba(255,183,3,0.1)]">
    <div class="w-full max-w-sm bg-white rounded-3xl shadow-xl shadow-[rgba(255,183,3,0.15)] p-8 border border-[rgba(2,48,71,0.06)] text-center">
      <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-[rgba(239,71,111,0.12)] flex items-center justify-center">
        <span class="text-4xl">🔒</span>
      </div>

      <h1 class="text-2xl font-black text-[#1A1A2E] mb-3">
        Cuenta no habilitada
      </h1>

      <p class="text-[#6B7280] mb-6 leading-relaxed">
        Tu cuenta aún no tiene acceso a la quiniela. Contacta al administrador para solicitar la habilitación.
      </p>

      <form action="/api/auth/signout" method="get">
        <button
          type="submit"
          class="w-full py-3.5 rounded-xl font-bold text-[#1A1A2E] bg-gradient-to-r from-[#FFB703] to-[#FB8500] hover:shadow-md hover:shadow-[rgba(251,133,0,0.3)] transition-all"
        >
          Cerrar sesión
        </button>
      </form>
    </div>
  </main>
</Layout>
